# Copy to .env in this directory on the server (never commit real values).
#   cp .env.example .env

# --- Domains / TLS (production) ---
YAKOSLOTS_DOMAIN=example.com
# Deprecated fallback when YAKOSLOTS_DOMAIN is unset (Symfony uses BASE_DOMAIN in the app .env).
# BASE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# --- Shared Docker network (must exist before gateway starts) ---
# Created by the Slotify app stack (docker-compose.prod.yaml). Do not create here in prod.
SLOTIFY_NETWORK_NAME=slotify

# --- Optional second app (own Compose file, external network `slotify`) ---
# Leave the domain empty to keep YAKOSLOTS-only routing (Caddyfile.prod unchanged).
# When set, the apex and every subdomain are reverse-proxied to the upstream.
# SECONDARY_APP_DOMAIN=other.example.com
# Compose service name on the `slotify` network (required unless SECONDARY_APP_UPSTREAM is set).
# SECONDARY_APP_UPSTREAM_HOST=other-app
# Port the container listens on (default 3030).
# SECONDARY_APP_UPSTREAM_PORT=3030
# Optional full host:port. When set, HOST and PORT are not used.
# SECONDARY_APP_UPSTREAM=other-app:3030

# --- Deploy hooks (always routed) ---
# Host: deploy-hooks.internal.yakoslots.online
# Upstream: the VPS process bound to 127.0.0.1:9088 (not a container).
# scripts/up.sh also starts deploy-hooks-loopback, which is on the host
# network and relays Caddy's unix socket to that loopback address.
# Public ACME needs a public A/AAAA for the hostname. No DNS-01 here.
# If the name exists only in private DNS, Let's Encrypt will not issue.
# Optional: must match home_units /etc/home_units/deploy-webhook.env (either mode).
# When set, Caddy sends header_up X-Deploy-Secret to the deploy-hooks upstream.
# DEPLOY_WEBHOOK_SECRET=

# --- Local dev only (docker-compose.dev.yaml) ---
# Path to the Slotify repo root on the host (for presentation /site/* static files).
# SLOTIFY_REPO_ROOT=/path/to/slotify